---
import Quote from "./icons/general/Quote.astro";

const metadata = {
  alt: "Gabe Newell",
  src: "/imgs/gabe.webp",
};
---

<div class="flex flex-row items-center justify-between gap-x-18 w-full mb-24">
  <!-- Img with solid shadow-->
  <div
    class="min-w-96 aspect-[3/4] flex relative hover:scale-105 transition-transform duration-500 ease-in-out"
  >
    <img
      src={metadata.src}
      alt={metadata.alt}
      class="rounded-[15px] min-w-96 object-cover object-top relative z-10"
    />
    <!-- Shadow -->
    <div
      class="bg-[#21252B] min-w-96 aspect-[3/4] rounded-[15px] absolute top-15 right-15 z-0"
    >
    </div>
  </div>
  <!-- Img with solid shadow-->

  <!-- Phrase -->
  <div class="gap-y-5 flex flex-col w-full">
    <div class="flex flex-col">
      <Quote class="size-32" />
      <div class="gap-y-7 flex flex-col">
        <p class="text-[#ABB2BF] italic font-light text-4xl">
          La clave del éxito es admitir que no sabes algo y luego descubrir cómo
          aprenderlo
        </p>
        <p class="text-[#ABB2BF] italic font-light text-4xl">- Gabe Newell</p>
      </div>
    </div>
  </div>
  <!-- Phrase -->
</div>
