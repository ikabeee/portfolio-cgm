---
import JoiningQueue from "./icons/general/JoiningQueue.astro";
import Card from "./ui/Card.astro";
import FormField from "./ui/FormField.astro";
import Button from "./ui/Button.astro";
import i18next from '../i18n/config';

const t = i18next.t.bind(i18next);

interface ContactInfo {
  icon: string;
  label: string;
  value: string;
  translateKey?: string;
}

const contactInfo: ContactInfo[] = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-[#569CDE]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>`,
    label: "location",
    value: "Quintana Roo, México",
    translateKey: "contact.location"
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-[#569CDE]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9l-9-4L22 2z"/>
          </svg>`,
    label: "email",
    value: "carlglz30@gmail.com",
    translateKey: "contact.emailLabel"
  },
];
---

<section class="flex flex-col gap-8">
  <h2 class="text-3xl font-semibold flex items-center gap-x-3 text-[#ABB2BF]">
    <JoiningQueue class="size-8" />    {t('contact.title')}
  </h2>

  <div class="flex flex-col lg:grid-cols-2 gap-8 max-w-7xl mx-auto w-full">
    <Card>
      <h3 class="text-xl font-semibold text-[#ABB2BF] mb-4">
        {t('contact.infoTitle')}
      </h3>
      <div class="space-y-4">
        {
          contactInfo.map(({ icon, value, translateKey }) => (
            <div class="flex items-center gap-3">
              <Fragment set:html={icon} />
              <p class="text-[#ABB2BF]/70">{translateKey ? t(translateKey) : value}</p>
            </div>
          ))
        }
      </div>
    </Card>

    <Card>
      <form id="contact-form" class="flex flex-col gap-4 space-y-1">
        <div class="space-y-1">
          <FormField 
            label={t('contact.name')} 
            name="name" 
            placeholder={t('contact.namePlaceholder')} 
          />
          <p class="text-red-500 text-sm hidden validation-message" data-for="name"></p>
        </div>

        <div class="space-y-1">
          <FormField
            label={t('contact.email')}
            name="email"
            placeholder={t('contact.emailPlaceholder')}
          />
          <p class="text-red-500 text-sm hidden validation-message" data-for="email"></p>
        </div>

        <div class="space-y-1">
          <FormField
            label={t('contact.message')}
            name="message"
            type="textarea"
            placeholder={t('contact.messagePlaceholder')}
            rows={4}
          />
          <p class="text-red-500 text-sm hidden validation-message" data-for="message"></p>
        </div>

        <p class="text-sm text-[#ABB2BF]/60">
          {t('contact.requiredFields')} <span class="text-red-500">*</span>
        </p>

        <div id="form-notification" class="hidden">
          <p class="text-[#569CDE]"></p>
        </div>

        <Button type="submit" variant="default" size="md">{t('contact.send')}</Button>
      </form>
    </Card>
  </div>
</section>

<script>
  import {
    validateContactForm,
    handleContactSubmit,
  } from "../utils/contactForm";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const notification = document.getElementById("form-notification");
  const validationMessages = document.querySelectorAll(".validation-message");

  const clearValidationMessages = () => {
    validationMessages.forEach((message) => {
      message.classList.add("hidden");
      message.textContent = "";
    });
  };

  const showFieldError = (fieldName: string, message: string) => {
    const messageElement = document.querySelector(`[data-for="${fieldName}"]`);
    if (messageElement) {
      messageElement.textContent = message;
      messageElement.classList.remove("hidden");
    }
  };

  form?.querySelectorAll("input, textarea").forEach((input) => {
    input.addEventListener("input", () => {
      const formData = new FormData(form);
      const { errors } = validateContactForm(formData);
      const messageElement = document.querySelector(`[data-for="${(input as HTMLInputElement | HTMLTextAreaElement).name}"]`);
      if (messageElement) {
        messageElement.classList.add("hidden");
        messageElement.textContent = "";
      }
    });
  });

  if (form && notification) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearValidationMessages();

      const formData = new FormData(form);
      const { isValid, errors } = validateContactForm(formData);

      if (!isValid) {
        Object.entries(errors).forEach(([field, message]) => {
          showFieldError(field, message);
        });
        return;
      }

      const result = await handleContactSubmit(formData);

      notification.classList.remove("hidden");
      notification.innerHTML = `
        <p class="${result.success ? "text-green-500" : "text-red-500"} text-sm">
          ${result.message}
        </p>
      `;

      if (result.success) {
        form.reset();
        setTimeout(() => {
          notification.classList.add("hidden");
        }, 5000);
      }
    });
  }
</script>
