---
import JoiningQueue from "./icons/general/JoiningQueue.astro"
import Card from "./ui/Card.astro"
import FormField from "./ui/FormField.astro"
import Button from "./ui/Button.astro"

interface ContactInfo {
  icon: string
  label: string
  value: string
}

const contactInfo: ContactInfo[] = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-[#569CDE]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>`,
    label: "Ubicación",
    value: "Quintana Roo, México"
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-[#569CDE]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9l-9-4L22 2z"/>
          </svg>`,
    label: "Email",
    value: "example@gmail.com"
  }
]
---

<section class="flex flex-col gap-8">
  <h2 class="text-3xl font-semibold flex items-center gap-x-3 text-[#ABB2BF]">
    <JoiningQueue class="size-8" />
    ¡Colaboremos!
  </h2>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-7xl mx-auto w-full">
    <Card>
      <h3 class="text-xl font-semibold text-[#ABB2BF] mb-4">Información de contacto</h3>
      <div class="space-y-4">
        {contactInfo.map(({ icon, label, value }) => (
          <div class="flex items-center gap-3">
            <Fragment set:html={icon} />
            <p class="text-[#ABB2BF]/70">{value}</p>
          </div>
        ))}
      </div>
    </Card>

    <Card>
      <form id="contact-form" class="flex flex-col gap-6">
        <FormField
          label="Nombre/Empresa"
          name="name"
          required
          placeholder="John Doe"
        />

        <FormField
          label="Correo"
          name="email"
          type="email"
          required
          placeholder="example@gmail.com"
        />

        <FormField
          label="Mensaje"
          name="message"
          type="textarea"
          required
          placeholder="Déjame un bonito mensaje :)"
          rows={4}
        />

        <p class="text-sm text-[#ABB2BF]/60">
          Los campos marcados con <span class="text-red-500">*</span> son obligatorios
        </p>

        <div id="form-notification" class="hidden">
          <p class="text-[#569CDE]"></p>
        </div>

        <Button type="submit" variant="default" size="lg">
          Enviar
        </Button>
      </form>
    </Card>
  </div>
</section>

<script>
  import { validateContactForm, handleContactSubmit } from '../utils/contactForm'

  const form = document.getElementById('contact-form') as HTMLFormElement
  const notification = document.getElementById('form-notification')

  if (form && notification) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      
      const formData = new FormData(form)
      const { isValid, errors } = validateContactForm(formData)

      if (!isValid) {
        // Show errors
        notification.classList.remove('hidden')
        notification.innerHTML = `
          <ul class="text-red-500">
            ${Object.values(errors).map(error => `<li>${error}</li>`).join('')}
          </ul>
        `
        return
      }

      const result = await handleContactSubmit(formData)
      
      notification.classList.remove('hidden')
      notification.innerHTML = `
        <p class="${result.success ? 'text-green-500' : 'text-red-500'}">
          ${result.message}
        </p>
      `

      if (result.success) {
        form.reset()
      }
    })
  }
</script>