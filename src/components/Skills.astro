---
import Code from "./icons/general/Code.astro"
import Card from "./ui/Card.astro"
import { skillCategories } from "../config/skills"
---

<section class="flex flex-col gap-8">
  <h2 class="text-3xl font-semibold flex items-center gap-x-3 text-[#ABB2BF]">
    <Code class="size-8" />
    Habilidades
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {Object.values(skillCategories).map(category => (
      <Card>
        <header class="flex items-center gap-4 mb-4">
          <category.icon class="size-6" />
          <h3 class="text-xl text-[#ABB2BF]">{category.title}</h3>
        </header>
        <div class="flex flex-wrap gap-2">
          {category.skills.map(skill => (
            <span class="bg-[#282C34] border border-[#363C49] rounded px-2 py-1 text-sm text-[#ABB2BF]">
              {skill.name}
            </span>
          ))}
        </div>
      </Card>
    ))}
  </div>
</section>