---
interface Props {
  variant?: 'default' | 'outline' | 'ghost'
  size?: 'sm' | 'md' | 'lg'
  class?: string
  [key: string]: any
}

const {
  variant = 'default',
  size = 'md',
  class: className,
  ...props
} = Astro.props

const variants = {
  default: 'bg-[#61AFEF] hover:scale-95 text-white',
  outline: 'border border-[#363C49] hover:bg-[#21252B] text-[#ABB2BF]',
  ghost: 'hover:bg-[#21252B] text-[#ABB2BF]'
}

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
}
---

<button
  class:list={[
    'rounded-lg transition-all duration-300 font-medium flex items-center justify-center gap-2',
    variants[variant],
    sizes[size],
    className
  ]}
  {...props}
>
  <slot/>
</button>
