---
import BackendDev from "./icons/general/BackendDev.astro"
import Card from "./ui/Card.astro"
import { experiences } from "../config/experience"
---

<section class="flex flex-col gap-8">
  <h2 class="text-3xl font-semibold flex items-center gap-x-3 text-[#ABB2BF]">
    <BackendDev class="size-8" />
    Experiencia Laboral
  </h2>

  <div class="flex flex-col gap-8">
    {experiences.map(experience => (
      <Card>
        <header class="flex flex-col">
          <h3 class="text-xl font-semibold text-[#ABB2BF]">{experience.title}</h3>
          <h4 class="text-lg text-[#ABB2BF]/80">{experience.company}</h4>
          <span class="text-sm text-[#ABB2BF]/70">{experience.period} · {experience.location}</span>
        </header>

        <p class="text-[#ABB2BF]/70 text-pretty mt-3">
          {experience.description}
        </p>

        <footer class="flex flex-wrap gap-2 mt-4">
          {experience.technologies.map(tech => (
            <span class="bg-[#282C34] border border-[#363C49] rounded px-2 py-1 text-sm text-[#ABB2BF]">
              {tech}
            </span>
          ))}
        </footer>
      </Card>
    ))}
  </div>
</section>
