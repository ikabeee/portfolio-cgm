---
const navItems = [
  {href: "/about-me", label: "Acerca de mí"},
  {href: "/skills", label: "Habilidades"},
  {href: "/projects", label: "Proyectos"},
  {href: "/contact", label: "Contacto"},
]
---
<header class="border-[#363C49] bg-[#282C34] sticky top-0 w-full mb-16">
  <!-- Navbar -->
  <nav class="flex max-w-screen-xl justify-between items-center mx-auto p-4">
    <a href="/"><span class="text-[#ABB2BF] text-2xl font-[600]">Carlos Gonzalez</span></a>
      <ul class="flex flex-row text-[#ABB2BF] gap-x-[40px]">
        <!-- NavbarItems -->
      {navItems.map((item)=>(
        <li class="relative w-max group">
          <a href={item.href}>{item.label}</a>
          <span
            class="absolute -bottom-1 left-0 w-0 transition-all h-0.5 bg-[#ABB2BF] group-hover:w-full"
          ></span>
        </li>
      ))}
      </ul>
  </nav>
  <!-- Divider -->
  <div class="h-[1px] w-full bg-[#363C49]"></div>
</header>