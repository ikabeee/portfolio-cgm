---
import Code from "./icons/general/Code.astro"
---

<section class="flex flex-col gap-8">  <h2 class="text-3xl font-semibold flex items-center gap-x-3 text-[#ABB2BF]">
    <Code class="size-8" />
    Proyectos
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <article class="rounded-xl bg-[#21252B] border border-[#363C49] p-6 flex flex-col">
      <h3 class="text-2xl font-semibold text-[#ABB2BF] mb-2">Explore Your University</h3>
      <p class="text-lg text-pretty text-[#ABB2BF]/70 grow">
        Plataforma educativa que permite a los estudiantes explorar y descubrir nuevas oportunidades en su universidad.
      </p>
      <footer class="flex gap-x-4 mt-4">
        <span class="bg-[#282C34] border border-[#363C49] rounded px-3 py-1 text-[#ABB2BF]">React</span>
        <span class="bg-[#282C34] border border-[#363C49] rounded px-3 py-1 text-[#ABB2BF]">TailwindCSS</span>
        <span class="bg-[#282C34] border border-[#363C49] rounded px-3 py-1 text-[#ABB2BF]">Node.js</span>
      </footer>
    </article>

    <!-- Placeholder para más proyectos -->
  </div>
</section>